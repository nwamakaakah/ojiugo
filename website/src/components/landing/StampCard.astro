---
interface Props { img: string; name: string; desc: string; when: string; place: string; tilt?: number; class?: string }
const { img, name, desc, when, place, tilt = 0, class: cls = '' } = Astro.props;
---
<figure class={`stamp ${cls}`} style={`--tilt:${tilt}deg`}>
  <div class="paper">
    <p class="hello">meet my feathered friend</p>
    <div class="photo"><span class="tape"></span><img src={img} alt={name} loading="lazy" /></div>
    <figcaption>
      <p class="name">{name}</p>
      <p class="desc">{desc}</p>
      <div class="chips"><span>☽ {when}</span><span>{place}</span></div>
    </figcaption>
    <p class="post"><img src="/illustrations/logo-nav.svg" alt="" width="18" height="15" /><b>ỌJỊUGO BIRD POST</b> ojiugo.club</p>
  </div>
</figure>

<style>
  .stamp { margin: 0; width: 330px; transform: rotate(var(--tilt)); filter: drop-shadow(0 8px 18px rgba(68,73,54,.16)); }
  .paper {
    position: relative; display: flex; flex-direction: column; gap: 10px; padding: 26px 22px 20px;
    background: #f1ecdd;
    /* deckled edge */
    -webkit-mask: radial-gradient(circle at 6px 6px, transparent 3.2px, #000 3.6px) -6px -6px / 12px 12px repeat-x, radial-gradient(circle at 6px 6px, transparent 3.2px, #000 3.6px) -6px calc(100% + 6px) / 12px 12px repeat-x, radial-gradient(circle at 6px 6px, transparent 3.2px, #000 3.6px) -6px -6px / 12px 12px repeat-y, radial-gradient(circle at 6px 6px, transparent 3.2px, #000 3.6px) calc(100% + 6px) -6px / 12px 12px repeat-y, linear-gradient(#000 0 0) 6px 6px / calc(100% - 12px) calc(100% - 12px) no-repeat;
    mask: radial-gradient(circle at 6px 6px, transparent 3.2px, #000 3.6px) -6px -6px / 12px 12px repeat-x, radial-gradient(circle at 6px 6px, transparent 3.2px, #000 3.6px) -6px calc(100% + 6px) / 12px 12px repeat-x, radial-gradient(circle at 6px 6px, transparent 3.2px, #000 3.6px) -6px -6px / 12px 12px repeat-y, radial-gradient(circle at 6px 6px, transparent 3.2px, #000 3.6px) calc(100% + 6px) -6px / 12px 12px repeat-y, linear-gradient(#000 0 0) 6px 6px / calc(100% - 12px) calc(100% - 12px) no-repeat;
  }
  .paper::before { content: ''; position: absolute; inset: 12px; background: #fcf9f1; border-radius: 4px; z-index: -1; }
  .paper > * { position: relative; }
  .hello { font-family: var(--font-hand); font-size: 15px; line-height: 18px; text-align: center; color: #221d17; background: repeating-linear-gradient(#fcf9f1 0 17px, #e9e3d3 17px 18px); padding: 2px 0; }
  .photo { position: relative; border-radius: 18px; overflow: visible; }
  .photo img { width: 100%; aspect-ratio: 1.22; object-fit: cover; border-radius: 18px; }
  .tape { position: absolute; top: -7px; left: 50%; width: 44px; height: 14px; transform: translateX(-50%); background: rgba(225, 212, 190, .9); z-index: 1; }
  figcaption { display: flex; flex-direction: column; align-items: center; gap: 6px; text-align: center; }
  .name { font-weight: 600; font-size: 15px; line-height: 20px; }
  .desc { font-size: 9.5px; line-height: 13px; color: #4c463d; max-width: 230px; }
  .chips { display: flex; gap: 6px; justify-content: center; margin-top: 4px; }
  .chips span { padding: 5px 10px; border: 1px solid #cac4b5; border-radius: 999px; font-size: 9px; line-height: 11px; background: #fcf9f1; }
  .post { display: flex; align-items: center; justify-content: center; gap: 6px; font-size: 7.5px; color: #4c463d; border-top: 1px solid #e9e3d3; padding-top: 10px; }
  .post b { font-weight: 600; letter-spacing: .8px; }
  .post img { width: 18px; height: 15px; }
</style>
