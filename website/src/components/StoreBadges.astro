---
import { STORE } from '../data/site';
interface Props { size?: 'md' | 'lg' }
const { size = 'md' } = Astro.props;
const g = STORE.google || '/waitlist';
const a = STORE.apple || '/waitlist';
---
<div class={`badges ${size}`}>
  <a class="badge" href={g} aria-label="Get it on Google Play">
    <svg class="glyph" viewBox="0 0 28 30" aria-hidden="true">
      <path d="M1.2 1.1 15.3 15 1.2 28.9c-.4-.3-.6-.8-.6-1.4V2.5c0-.6.2-1.1.6-1.4Z" fill="#4285F4"/>
      <path d="m20 10.3-4.7 4.7L1.2 1.1c.5-.4 1.2-.5 1.9-.1L20 10.3Z" fill="#34A853"/>
      <path d="m20 19.7-16.9 9.3c-.7.4-1.4.3-1.9-.1L15.3 15l4.7 4.7Z" fill="#EA4335"/>
      <path d="m25.5 13.3-5.5-3-4.7 4.7 4.7 4.7 5.5-3c1.4-.8 1.4-2.6 0-3.4Z" fill="#FBBC04"/>
    </svg>
    <span class="words"><small>GET IT ON</small><b>Google Play</b></span>
  </a>
  <a class="badge" href={a} aria-label="Download on the App Store">
    <svg class="glyph apple" viewBox="0 0 24 28" aria-hidden="true">
      <path fill="#fff" d="M19.6 14.9c0-3.3 2.7-4.9 2.8-5-1.5-2.2-3.9-2.5-4.7-2.6-2-.2-3.9 1.2-4.9 1.2-1 0-2.6-1.2-4.2-1.1-2.2 0-4.2 1.3-5.3 3.2-2.3 3.9-.6 9.7 1.6 12.9 1.1 1.6 2.4 3.3 4.1 3.2 1.6-.1 2.3-1 4.2-1 2 0 2.5 1 4.2 1 1.8 0 2.9-1.6 3.9-3.2 1.2-1.8 1.8-3.6 1.8-3.7-.1 0-3.5-1.3-3.5-4.9ZM16.4 5.3c.9-1.1 1.5-2.6 1.3-4.1-1.3.1-2.9.9-3.8 2-.8.9-1.6 2.5-1.4 4 1.5.1 3-.8 3.9-1.9Z"/>
    </svg>
    <span class="words"><b>App Store</b><small>Download on the</small></span>
  </a>
</div>

<style>
  .badges { display: flex; gap: 12px; flex-wrap: wrap; }
  .badge { display: inline-flex; align-items: center; gap: 10px; height: 60px; padding: 0 18px 0 14px; border-radius: 10px; background: #2c261f; color: #fff; transition: transform .15s ease, background .2s ease; }
  .badge:hover { background: #3a332a; transform: translateY(-1px); }
  .glyph { width: 26px; height: 28px; flex: none; }
  .glyph.apple { width: 22px; height: 26px; }
  .words { display: flex; flex-direction: column; line-height: 1; font-family: -apple-system, 'Helvetica Neue', Arial, sans-serif; }
  .words small { font-size: 9px; letter-spacing: .3px; }
  .words b { font-weight: 500; font-size: 19px; letter-spacing: -.2px; margin: 2px 0; }
  .md .badge { height: 60px; }
  @media (max-width: 1024px) {
    .badge { height: 46px; padding: 0 14px 0 10px; gap: 8px; border-radius: 8px; }
    .glyph { width: 20px; height: 22px; } .glyph.apple { width: 17px; height: 20px; }
    .words b { font-size: 15px; } .words small { font-size: 7.5px; }
  }
</style>
