---
// Landing Page (Figma "Website" → Desktop 2012:2445 / Mobile 2012:395)
import Base from '../layouts/Base.astro';
import StoreBadges from '../components/StoreBadges.astro';
import CtaBand from '../components/CtaBand.astro';

const features = [
  { icon: 'feather', tone: 'plum', title: 'log a sighting in seconds', body: 'drop a quick note in the field, then come back to fill in the details when you’re home. no sighting slips through the cracks' },
  { icon: 'ring', tone: 'gold', title: 'capture the feeling too', body: 'was it wonder? joy? calm? record the feeling while it’s fresh — your diary keeps every emotion exactly as you felt it in the moment' },
  { icon: 'book', tone: 'clay', title: 'mystery birds welcome', body: 'can’t id it yet? log it anyway. it lives in your diary as a mystery bird until you’re ready to name it — or we suggest a match' },
];
---
<Base title="your cosy bird diary" description="log your sightings, note how they made you feel, and build a personal field journal that’s yours to keep — one bird at a time.">
  <!-- hero -->
  <section class="section hero">
    <div class="inner hero-inner">
      <div class="hero-text">
        <p class="t-overline">your cosy bird diary</p>
        <h1><span class="nw">a little diary for</span> <span class="nw">the <span class="birds">birds</span> you meet</span></h1>
        <p class="t-body-lg lede">log your sightings, note how they made you feel, and build a personal field journal that’s yours to keep — one bird at a time</p>
        <StoreBadges />
      </div>
      <div class="hero-art">
        <img class="hero-img" src="/images/app/hero-phone.webp" width="1014" height="1878" fetchpriority="high" alt="The ọjịugo app showing a diary page for a Sunbird: a photo of the bird on a branch, the time and place it was seen, and the feelings joyful and singing" />
      </div>
    </div>
  </section>

  <!-- not a checklist -->
  <section class="section remember">
    <div class="inner center">
      <p class="t-overline">not a checklist. a field journal.</p>
      <h2>most bird apps count.<br />ọjịugo remembers</h2>
      <p class="t-body-lg">other apps turn birding into a spreadsheet of ticks and tallies. ọjịugo is a diary — a place for the moment, the light, the way your heart lifted when it landed. you keep the story, not just the species count</p>
    </div>
  </section>

  <!-- features -->
  <section class="section features">
    <div class="inner">
      <div class="head">
        <p class="t-overline">built for the way you actually bird</p>
        <h2>everything a field<br />journal should be</h2>
      </div>
      <ul class="cards">
        <li class="card">
          <div class="art">
            <img class="shot" src="/images/app/feature-scribbles.webp" width="555" height="553" loading="lazy" alt="The scribbles screen: quick notes waiting for the full story, like a probable Yellow Warbler seen on the marsh trail" />
          </div>
          <div class="copy">
            <span class={`ic ${features[0].tone}`}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"><path d="M5 19c3-6 7-10 13-14-1 6-4 11-10 13"/><path d="M5 19l5-6"/></svg></span>
            <h3>{features[0].title}</h3><p class="t-body-md">{features[0].body}</p>
          </div>
        </li>
        <li class="card">
          <div class="art">
            <img class="shot" src="/images/app/feature-diary.webp" width="555" height="553" loading="lazy" alt="The write your diary screen: how did you feel? with joyful, awe, calm, wonder and proud, and a space to say more" />
          </div>
          <div class="copy">
            <span class={`ic ${features[1].tone}`}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M12 4.2c4.6-.1 8 3.3 7.8 7.9-.2 4.3-3.6 7.7-7.9 7.6-4.4-.1-7.8-3.6-7.6-7.9.2-4.2 3.5-7.5 7.7-7.6Z"/></svg></span>
            <h3>{features[1].title}</h3><p class="t-body-md">{features[1].body}</p>
          </div>
        </li>
        <li class="card">
          <div class="art">
            <img class="shot" src="/images/app/feature-name.webp" width="555" height="553" loading="lazy" alt="The two to name screen: the app suggests a jul 8 bird might be a Spur-winged wagtail, with a button to view the bird’s info" />
          </div>
          <div class="copy">
            <span class={`ic ${features[2].tone}`}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"><rect x="6" y="4" width="12" height="16" rx="1.5"/><path d="M9 4v16M11.5 9h4M11.5 12h4"/></svg></span>
            <h3>{features[2].title}</h3><p class="t-body-md">{features[2].body}</p>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <!-- stamps -->
  <section class="section stamps">
    <div class="inner stamps-inner">
      <div class="stamps-text">
        <p class="t-overline">share the moment</p>
        <h2>every bird earns its<br />own stamp</h2>
        <p class="t-body-lg">turn any sighting into a collectible stamp card — a little keepsake from your diary, ready to send to a friend</p>
        <p class="t-body-lg">a small, lovely way to say look what I found today</p>
      </div>
      <div class="stamps-art">
        <img class="stamps-img" src="/images/app/stamps.webp" width="1372" height="1121" loading="lazy" alt="Two ọjịugo stamp cards: a Village weaver seen at midfield park and a Barn swallow at el paradiso, each with a photo, a short description, the date and place" />
      </div>
    </div>
  </section>

  <CtaBand variant="home" />
</Base>

<style>
  /* hero */
  .hero { padding-top: 160px; overflow: hidden; }
  .hero-inner { display: grid; grid-template-columns: minmax(0, 1fr) 420px; gap: 24px; align-items: start; }
  .hero-text { display: flex; flex-direction: column; gap: 24px; padding-top: 150px; padding-bottom: 200px; }
  h1 { font-weight: 600; font-size: clamp(40px, 4.8vw, 62px); line-height: 1.094; max-width: 660px; }
  .birds { color: #8a5a3c; }
  .nw { white-space: nowrap; }
  @media (max-width: 1024px) { .nw { white-space: normal; } }
  .lede { max-width: 590px; }
  .hero-text :global(.badges) { margin-top: 24px; }
  .hero-art { position: relative; height: 710px; }
  /* the full phone is taller than the hero — the section edge crops it, so tilting never shows a cut side */
  .hero-img { position: absolute; top: 160px; left: -10px; width: 470px; max-width: none; height: auto; }
  .twig { position: absolute; pointer-events: none; }
  .twig-l { left: -40px; top: 300px; width: 120px; transform: scaleX(-1) rotate(70deg); z-index: 2; opacity: .95; }
  .twig-in { right: -40px; top: -10px; width: 190px; z-index: 0; }

  /* phone innards */
  :global(.phone) .p-back { font-size: 10px; margin: 6px 0 10px 4px; position: relative; z-index: 1; }
  .page { position: relative; z-index: 1; margin: 18px 0 0; padding: 16px 14px; background: #fcf9f1; border-radius: 4px; display: flex; flex-direction: column; gap: 10px; min-height: 520px; }
  .lined { background: repeating-linear-gradient(#fcf9f1 0 31px, #ece6d7 31px 32px); }
  .snap { position: relative; }
  .snap img { width: 100%; aspect-ratio: 1.6; object-fit: cover; border-radius: 22px; }
  .tape { position: absolute; top: -8px; left: 50%; transform: translateX(-50%); width: 46px; height: 16px; background: rgba(229, 214, 195, .95); z-index: 1; }
  .tape.r { left: auto; right: 24px; transform: none; }
  .title-row { display: flex; align-items: center; justify-content: space-between; margin-top: 6px; }
  .bird { font-weight: 600; font-size: 17px; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .chip { display: inline-flex; align-items: center; gap: 5px; padding: 6px 12px; border: 1px dashed #cac4b5; border-radius: 999px; font-size: 10px; line-height: 12px; background: #fcf9f1; }
  .chip.sing { background: #dddfd4; border-color: #afb7a2; color: #575f47; }
  .chip.joy { background: #605668; border: 0; color: #fdfaf1; }
  .chip.joy i { width: 14px; height: 14px; border-radius: 50%; border: 1.4px solid #fdfaf1; }
  .over { font-weight: 600; font-size: 8px; letter-spacing: .8px; text-transform: uppercase; color: #6b655b; margin-top: 8px; }

  /* remember */
  .remember { background: var(--surface-page); padding-top: 150px; padding-bottom: 150px; }
  .center { display: flex; flex-direction: column; align-items: center; gap: 24px; text-align: center; }
  .center p.t-body-lg { max-width: 590px; }
  h2 { font-weight: 600; font-size: clamp(32px, 3.75vw, 48px); line-height: 1.167; }

  /* features */
  .features { padding-top: 150px; padding-bottom: 150px; }
  .head { display: flex; flex-direction: column; gap: 24px; margin-bottom: 64px; }
  .cards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .card { background: var(--surface-page); border-radius: var(--radius-xl); overflow: hidden; display: flex; flex-direction: column; box-shadow: var(--shadow-sm); }
  .art { height: 245px; overflow: hidden; display: flex; justify-content: center; padding-top: 36px; background: #fbf8ef; }
  .art :global(.mini) { width: 200px; height: 420px; flex: none; }
  .shot { width: 260px; max-width: 86%; height: auto; align-self: flex-start; flex: none; }
  .hand { font-family: var(--font-hand); font-size: 15px; line-height: 18px; margin-top: 2px; }
  .sub { font-size: 7.5px; color: #4c463d; margin-bottom: 10px; }
  .note { position: relative; background: #fcf9f1; border-radius: 10px; padding: 10px; display: flex; flex-direction: column; gap: 6px; margin-bottom: 10px; font-size: 8px; line-height: 12px; box-shadow: 0 1px 3px rgba(68,73,54,.08); }
  .note .tape { width: 26px; height: 9px; top: -4px; left: 30px; transform: none; }
  .note.ghost { height: 40px; }
  .meta { font-size: 6.5px; color: #6b655b; }
  .meta.link { color: #221d17; font-size: 7px; }
  .feels { display: flex; flex-wrap: wrap; gap: 5px; margin: 6px 0 12px; }
  .f { display: inline-flex; align-items: center; gap: 4px; padding: 4px 8px 4px 5px; border-radius: 999px; font-size: 7px; line-height: 9px; }
  .f i { width: 10px; height: 10px; border-radius: 50%; border: 1px solid currentColor; }
  .f.joy { background: #e0dce1; color: #605668; } .f.joy.on { background: #605668; color: #fdfaf1; }
  .f.awe { background: #efe5d1; color: #886e3d; } .f.calm { background: #ebe8ea; color: #766a83; }
  .f.wonder { background: #eed9ca; color: #854e2c; } .f.proud { background: #e4e8dc; color: #6b775c; }
  .poetic { font-size: 7.5px; color: #8a8479; border-bottom: 1px solid #cac4b5; padding: 4px 0; margin-top: 4px; }
  .guess { display: flex; gap: 8px; align-items: center; }
  .guess img { width: 30px; height: 30px; border-radius: 6px; object-fit: cover; }
  .guess p { font-size: 7.5px; line-height: 11px; color: #4c463d; } .guess b { color: #221d17; font-weight: 600; }
  .view { display: block; text-align: center; padding: 6px; border-radius: 999px; background: #575f47; color: #fdfaf1; font-size: 7px; }
  .copy { display: flex; flex-direction: column; gap: 12px; padding: 24px; position: relative; z-index: 1; background: var(--surface-page); flex: 1; }
  .ic { display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 50%; }
  .ic svg { width: 22px; height: 22px; }
  .ic.plum { background: #e0dce1; color: #605668; } .ic.gold { background: #efe5d1; color: #886e3d; } .ic.clay { background: #eadbd1; color: #7a533d; }
  h3 { font-weight: 600; font-size: 20px; line-height: 26px; margin-top: 4px; }

  /* stamps */
  .stamps { background: #ece7da; padding-top: 120px; padding-bottom: 120px; overflow: hidden; }
  .stamps-inner { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 48px; align-items: center; }
  .stamps-text { display: flex; flex-direction: column; gap: 24px; }
  .stamps-text p.t-body-lg { max-width: 470px; }
  .stamps-art { position: relative; }
  .stamps-img { width: 100%; max-width: 640px; height: auto; margin-left: auto; }

  @media (max-width: 1024px) {
    .hero-inner { grid-template-columns: 1fr; }
    .hero-text { padding-top: 0; padding-bottom: 0; }
    .hero-art { height: 480px; width: 100%; max-width: 410px; margin-inline: auto; overflow: hidden; }
    .hero-img { width: 100%; left: 0; top: 0; }
    .cards { grid-template-columns: 1fr; }
    .card .art { height: 300px; }
    .shot { width: 300px; }
    .stamps-inner { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .card .art { height: 245px; }
    .shot { width: 260px; }
  }
  @media (max-width: 1024px) {
    .hero { padding-top: 130px; }
    h1 { font-size: 40px; line-height: 48px; }
    .hero-text :global(.badges) { margin-top: 16px; }
    .hero-art { height: auto; aspect-ratio: 1014 / 1188; margin: 32px auto 0; width: 100%; max-width: 340px; overflow: hidden; }
    .hero-img { width: 100%; left: 0; top: 0; }
    .page { min-height: 420px; }
    .twig-l { display: none; }
    .remember, .features { padding-top: 100px; padding-bottom: 100px; }
    .center { text-align: center; }
    h2 { font-size: 32px; line-height: 40px; }
    .head { margin-bottom: 48px; }
    .stamps { padding-top: 100px; padding-bottom: 100px; }
    .stamps-img { margin: 0 auto; }
  }
</style>
