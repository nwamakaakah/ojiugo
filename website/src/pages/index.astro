---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Newsletter from '../components/Newsletter.astro';
import CtaBand from '../components/CtaBand.astro';
import CropImage from '../components/CropImage.astro';

const posts = (await getCollection('blog')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="birdie blog">
  <section class="section hero">
    <div class="inner hero-inner">
      <p class="t-overline"><span class="d">Learn about birding</span><span class="m">your cosy bird diary</span></p>
      <div class="hero-text">
        <h1>our little guide to deepen your birding habit</h1>
        <Newsletter id="hero-email" />
      </div>
    </div>
  </section>

  <section class="section posts-wrap" aria-label="articles">
    <div class="inner posts">
      {posts.map((p, i) => (
        <a class="card" href={`/blog/${p.id}`}>
          <CropImage class="card-img" src={p.data.image} alt={p.data.imageAlt} crop={p.data.cropCard} cropMobile={p.data.cropCardMobile} eager />
          <div class="card-text">
            <div class="card-copy">
              <h2>{p.data.cardTitle ?? p.data.title}</h2>
              <p class="t-body-md">{p.data.summary}</p>
            </div>
            <span class="t-button read">read article</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .hero { padding-top: 200px; }
  .hero-inner { display: flex; flex-direction: column; gap: 32px; }
  .hero-text { display: flex; flex-direction: column; gap: 48px; }
  h1 { font-weight: 600; font-size: clamp(40px, 5vw, 64px); line-height: 1.094; max-width: 842px; }
  .posts-wrap { padding-top: 100px; padding-bottom: 100px; }
  .posts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px; }
  .card { display: flex; flex-direction: column; background: var(--surface-page); border-radius: var(--radius-xl); overflow: hidden; box-shadow: var(--shadow-sm); transition: box-shadow .2s ease, transform .2s ease; }
  .card:hover { transform: translateY(-2px); box-shadow: 0 4px 14px rgba(68,73,54,.16); }
  .card :global(.card-img) { height: 256px; }
  .card-text { display: flex; flex-direction: column; gap: 16px; padding: 24px; }
  .card-copy { display: flex; flex-direction: column; gap: 16px; }
  h2 { font-weight: 600; font-size: 20px; line-height: 26px; }
  .read { padding: 8px 0; color: var(--text-interactive); }
  .m { display: none; }
  @media (max-width: 760px) {
    .hero { padding-top: 150px; }
    .hero-inner { gap: 16px; }
    .hero-text { gap: 48px; }
    h1 { font-size: 40px; line-height: 48px; }
    .posts-wrap { padding-top: 64px; padding-bottom: 64px; }
    .posts { grid-template-columns: 1fr; }
    .card :global(.card-img) { height: 184px; }
    h2 { font-size: 16px; }
    .d { display: none; } .m { display: inline; }
  }
</style>
