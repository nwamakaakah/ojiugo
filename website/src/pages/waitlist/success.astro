---
import Base from '../../layouts/Base.astro';
---
<Base title="your spot is saved" header="none" footer="mini">
  <section class="section done">
    <img class="nest" src="/illustrations/nest.svg" alt="" width="285" height="160" />
    <div class="text">
      <h1>your spot is saved</h1>
      <p class="t-body-md">we’ll let you know when it’s ready</p>
    </div>
    <a class="btn t-button" href="/">awesome</a>
  </section>
</Base>

<style>
  .done { min-height: calc(100vh - 104px); padding-top: 200px; padding-bottom: 100px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 32px; text-align: center; }
  .nest { width: 285px; height: auto; }
  .text { display: flex; flex-direction: column; gap: 12px; align-items: center; }
  h1 { font-weight: 600; font-size: 32px; line-height: 36px; }
  .text p { max-width: 269px; }
  .btn { width: 100%; max-width: 526px; }
  @media (max-width: 1024px) { .done { padding-top: 100px; } }
</style>
