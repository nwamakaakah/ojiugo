---
import '@fontsource/mali/400.css';
import '@fontsource/mali/500.css';
import '@fontsource/mali/600.css';
import '@fontsource/caveat/700.css';
import '../styles/global.css';
import '../styles/motion.css';
import Header from '../components/Header.astro';
// The main Latin font files, preloaded and declared with font-display: block so a new page never paints
// in the fallback font and then swaps (that swap is what made the type "change" as pages opened).
import mali400 from '@fontsource/mali/files/mali-latin-400-normal.woff2?url';
import mali500 from '@fontsource/mali/files/mali-latin-500-normal.woff2?url';
import mali600 from '@fontsource/mali/files/mali-latin-600-normal.woff2?url';
import caveat700 from '@fontsource/caveat/files/caveat-latin-700-normal.woff2?url';
const LATIN = 'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const faces = [['Mali', 400, mali400], ['Mali', 500, mali500], ['Mali', 600, mali600], ['Caveat', 700, caveat700]] as const;
const fontCss = faces.map(([f, w, u]) => `@font-face{font-family:'${f}';font-style:normal;font-weight:${w};font-display:block;src:url(${u}) format('woff2');unicode-range:${LATIN};}`).join('');
import Footer from '../components/Footer.astro';

interface Props {
  title?: string; description?: string;
  header?: 'nav' | 'back' | 'none'; backHref?: string; backLabel?: string;
  footer?: 'full' | 'mini';
}
const { title, description = 'ọjịugo — your cosy little bird diary.', header = 'nav', backHref, backLabel, footer = 'full' } = Astro.props;
const fullTitle = title ? `${title} · ọjịugo` : 'ọjịugo';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f2e6" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {faces.map(([, , u]) => <link rel="preload" href={u} as="font" type="font/woff2" crossorigin />)}
    <style is:inline set:html={fontCss}></style>
  </head>
  <body>
    <Header variant={header} backHref={backHref} backLabel={backLabel} />
    <main><slot /></main>
    <Footer variant={footer} />
    <script>import '../scripts/motion.ts';</script>
  </body>
</html>
